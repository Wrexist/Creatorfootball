# RevenueCat public SDK keys only. Never put a RevenueCat secret API key here.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Optional release-build gate: android or ios. Missing/test keys are rejected
# for the selected platform. Leave unset for local and unsigned qualification.
CF_PURCHASE_RELEASE_PLATFORM=
