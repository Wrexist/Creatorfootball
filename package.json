{
  "name": "creator-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @cf/game dev",
    "build": "pnpm --filter @cf/engine build && pnpm --filter @cf/game build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --filter @cf/engine test",
    "test:watch": "pnpm --filter @cf/engine test:watch",
    "audit:economy": "pnpm --filter @cf/sim audit:economy",
    "audit:sim": "pnpm --filter @cf/sim audit:sim",
    "audit:invariants": "pnpm --filter @cf/sim audit:invariants",
    "audit:all": "pnpm --filter @cf/sim audit:all",
    "lint:fix": "eslint . --fix",
    "test:smoke": "pnpm --filter @cf/game test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
