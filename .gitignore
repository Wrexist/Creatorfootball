node_modules/
dist/
dist-*/
build/
coverage/
.DS_Store
*.local
.env
.env.*
!.env.example
# Native shells are committed (they carry the Xcode project, plists and asset
# catalogues); only their build products and synced copies are ignored.
ios/App/output/
ios/App/Pods/
ios/App/public/
ios/App/capacitor.config.json
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/app/src/main/assets/public/
.vite/
*.tsbuildinfo
/tmp/
artifacts/

# Scratch scripts for the headless audit harness. Auditors write throwaway
# probes here; they are never part of the product.
tools/sim/src/zz*.ts
tools/sim/src/__*.ts
tools/sim/src/_audit/
.shots/

# Store-screenshot drafts rendered by tools/release/store-shots.mjs. The
# repo carries only the curated finals, in apps/game/fastlane/screenshots/.
tools/release/store-shots/

# Downloaded generations waiting to be ingested by `tools/brand/ingest.mjs`.
# They are working files — the pipeline's *output* is what the repo carries.
tools/brand/inbox/*
!tools/brand/inbox/.gitkeep
